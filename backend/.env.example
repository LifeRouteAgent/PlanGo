# Local backend development only.
# Docker deployment uses ../.env plus backend/config.docker.json.

APP_ENV=local
DEBUG=0

LLM_PROVIDER=deepseek
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-pro
DEEPSEEK_REASONING_EFFORT=high
DEEPSEEK_THINKING_ENABLED=false
LLM_TIMEOUT=60

AMAP_API_KEY=
AMAP_ROUTE_ENABLED=false

LIFEROUTE_USE_DATABASE=1
DATABASE_HOST=127.0.0.1
DATABASE_PORT=3306
DATABASE_USER=root
DATABASE_PASSWORD=
DATABASE_NAME=life_route_agent

REDIS_URL=redis://127.0.0.1:6379/0

MILVUS_ENABLED=1
MILVUS_HOST=127.0.0.1
MILVUS_PORT=19530
MILVUS_COLLECTION_MEMORY=liferoute_memory
MILVUS_COLLECTION_USER_PROFILE=liferoute_user_profile_vectors

EMBEDDING_PROVIDER=local_bge
EMBEDDING_MODEL_PATH=BAAI/bge-small-zh-v1.5
EMBEDDING_DIMENSION=512

RUNTIME_STORE=mysql
RUNTIME_MYSQL_ENABLED=1
PROMPT_VERSION_ENFORCED=1
KAFKA_ENABLED=0
KAFKA_BOOTSTRAP_SERVERS=127.0.0.1:9092
KAFKA_MEMORY_TOPIC=liferoute.memory.events

MAX_RECENT_TURNS=8
MAX_MEMORY_ITEMS=20
DEFAULT_CITY=北京
DEFAULT_DISTANCE_KM=8
DEFAULT_BUDGET_LEVEL=medium
ROUTE_PROVIDER=amap
ENABLE_MEMORY=1
ENABLE_VERIFICATION=1
ENABLE_TRACE=1
