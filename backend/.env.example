MIMO_API_KEY=
MIMO_BASE_URL=https://api.xiaomimimo.com/v1
MIMO_MODEL=mimo-v2.5-pro
AMAP_API_KEY=                 # 配置后 Route Planner 会尝试调用高德步行/驾车路线接口；失败自动回退 Haversine
APP_ENV=local
DEBUG=0
DATABASE_URL=
REDIS_URL=
ES_URL=
LLM_PROVIDER=deepseek
LLM_MODEL=deepseek-v4-pro
LLM_TIMEOUT=60
MAX_RECENT_TURNS=8
MAX_MEMORY_ITEMS=20
DEFAULT_CITY=北京
DEFAULT_DISTANCE_KM=8
DEFAULT_BUDGET_LEVEL=medium
ROUTE_PROVIDER=amap
ENABLE_MEMORY=1
ENABLE_VERIFICATION=1
ENABLE_TRACE=1
LIFEROUTE_USE_DATABASE=1
DATABASE_HOST=127.0.0.1
DATABASE_PORT=3306
DATABASE_USER=root
DATABASE_PASSWORD=
DATABASE_NAME=life_route_agent
MILVUS_ENABLED=1
MILVUS_HOST=127.0.0.1
MILVUS_PORT=19530
MILVUS_COLLECTION_MEMORY=liferoute_memory
MILVUS_COLLECTION_USER_PROFILE=liferoute_user_profile_vectors
EMBEDDING_PROVIDER=local_bge
EMBEDDING_MODEL_PATH=BAAI/bge-small-zh-v1.5
EMBEDDING_DIMENSION=512
