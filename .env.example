COMPOSE_PROJECT_NAME=liferoute

# Required for MySQL.
MYSQL_ROOT_PASSWORD=change-me-please

# Required for Milvus object storage.
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=change-me-please

# LLM provider used by backend/app/config.py and backend/config.docker.json.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-pro
DEEPSEEK_REASONING_EFFORT=high
DEEPSEEK_THINKING_ENABLED=false

# AMap key used by backend route planning and frontend map rendering.
AMAP_API_KEY=
AMAP_SECURITY_JS_CODE=
AMAP_ROUTE_ENABLED=true

# Redis cache/session context.
REDIS_URL=redis://redis:6379/0
